{
  "rtk-rewrite": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'command -v rtk >/dev/null 2>&1 || exit 0; exec rtk hook antigravity'",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
